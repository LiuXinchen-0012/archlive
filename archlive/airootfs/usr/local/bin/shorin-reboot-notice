#!/usr/bin/env bash
# ============================================================================
# shorin-reboot-notice —— 首次启动后，提示用户"KDE 已删，建议重启"
#
# 为什么需要这个独立脚本：
#   删 KDE 发生在【第一次开机】、而用户【正坐在 KDE 会话里】。
#   重启提示如果只写在 niri 的 config.kdl 里，那它要等重启完、进 niri 才看得到 ——
#   而用户恰恰需要"现在就去重启"这个提示。循环了。
#
#   解决：这段逻辑做成会话无关的脚本，两边都调它：
#     · ~/.config/autostart/shorin-reboot-notice.desktop  → 第一次开机的 KDE 会话
#     · ~/.config/niri/config.kdl 的 spawn-at-startup        → 重启后的 niri
#   两处检查同一个标记文件 /var/lib/shorin-need-reboot。
#
# 行为：检查标记 -> 弹通知 -> 每 60 秒再提醒一次（最多 10 次）-> 标记已看过
# ============================================================================
set -uo pipefail

FLAG=/var/lib/shorin-need-reboot
SEEN="${XDG_STATE_HOME:-$HOME/.local/state}/shorin/reboot-notice-seen"
TIMES="${XDG_STATE_HOME:-$HOME/.local/state}/shorin/reboot-notice-times"
MAX_TIMES=10

# 标记不在 = 没删过 KDE（或者已经重启过了），什么都不做
[[ -f "$FLAG" ]] || exit 0

mkdir -p "$(dirname "$SEEN")" 2>/dev/null || true

# 已经提醒过 10 次就闭嘴，别烦人
n=$(cat "$TIMES" 2>/dev/null | tr -cd '0-9')
n=${n:-0}
[[ "$n" -ge "$MAX_TIMES" ]] && exit 0
echo $((n + 1)) > "$TIMES" 2>/dev/null || true

TITLE="建议现在重启"
BODY="KDE Plasma 已被卸载，当前桌面将切换为 Shorin DMS Niri。

请执行：  reboot
（在终端里输入，或点关机按钮）

不重启的话，dolphin / konsole 等 KDE 应用会打不开。"

# 1) 优先发桌面通知（两种会话都支持 notify-send）
if command -v notify-send > /dev/null 2>&1; then
  # 第一次用 critical 抢眼，之后降级成 normal
  URGENCY="normal"
  TIMEOUT_MS=0
  [[ "$n" -eq 0 ]] && URGENCY="critical"
  [[ "$n" -ge 3 ]] && TIMEOUT_MS=10000
  notify-send -u "$URGENCY" -t "$TIMEOUT_MS" "$TITLE" "$BODY" 2>/dev/null || true
fi

# 2) 不管通知有没有生效，都在桌面上放一个文件 —— 通知守护进程挂了也看得见
DESKTOP_DIR="${XDG_DESKTOP_DIR:-$HOME/Desktop}"
if [[ -d "$DESKTOP_DIR" ]]; then
  cat > "$DESKTOP_DIR/⚠ 建议重启进入 Niri.txt" <<EOF
$TITLE
================================================

$BODY

原因：安装程序在第一次启动时卸载了 KDE Plasma，并把显示管理器切换到了
greetd（开机直接进入 Shorin DMS Niri）。这些改动需要重启一次才会生效。

怎么重启：
  · 打开终端输入  reboot
  · 或者点左上角电源按钮 -> 重启

状态：
  · 标记文件：$FLAG
  · 本次已提醒 $((n + 1)) 次（最多 $MAX_TIMES 次）
  · 日志：/var/log/shorin-remove-kde.log
EOF
fi

exit 0
