[Desktop Entry]
Type=Application
Version=1.0
Name=代理订阅设置
Name[en]=Proxy subscription
Comment=填好后再点"安装 Arch Linux"；或直接用文本框编辑订阅链接文件
Comment[en]=Fill this in before launching the installer
Exec=kdialog --title "代理订阅" --text "填好点确定即可。如果已经点了安装图标，这个可以不管。\n\n没有订阅链接也可以留空继续安装。" --inputbox "Clash 订阅链接：" "$(cat /tmp/proxy_subscription 2>/dev/null)"
Icon=network-server
Terminal=false
Categories=Network;
