# 强制 shell 脚本用 LF 换行 —— 这条不做，Windows 上 clone 出来的
# .sh 会带 CRLF，在 CI 里报 "\r: command not found"，整个构建崩掉。
* text=auto eol=lf

*.sh        text eol=lf
profiledef.sh  text eol=lf
PKGBUILD*  text eol=lf
*.py       text eol=lf
*.conf     text eol=lf
*.kdl      text eol=lf
*.desktop  text eol=lf
*.md       text eol=lf
*.yml      text eol=lf

# 二进制，绝不要做行尾转换也不要 diff
*.iso      binary
*.zst      binary
*.xz       binary
*.gz       binary
*.png      binary
*.svg      binary
*.ttf      binary
